<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:LithophaneGUI.Controls"
        xmlns:l="using:LithophaneGUI.Localization"
        x:Class="LithophaneGUI.MainWindow"
        Icon="/Assets/icon.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="380,4,*">

    <!-- Settings panel -->
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Bottom" Margin="12" Spacing="6">
        <TextBlock x:Name="InfoText" Classes="hint" Text="{l:T Info.Empty}" />
        <Grid x:Name="LayoutRow" ColumnDefinitions="Auto,*" IsVisible="False">
          <TextBlock Classes="label" Text="{l:T Export.As}" c:Help.Topic="Layout" />
          <ComboBox x:Name="LayoutCombo" c:Help.Topic="Layout" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0"
                    SelectionChanged="OnLayoutChanged">
            <ComboBoxItem Content="{l:T Layout.Separate}" />
            <ComboBoxItem Content="{l:T Layout.SideBySide}" />
            <ComboBoxItem Content="{l:T Layout.Assembled}" />
          </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="*,6,*">
          <Button x:Name="ExportButton" Grid.Column="0" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Classes="accent" Content="{l:T Export.Stl}"
                  Click="OnExportClick" IsEnabled="False" />
          <Button x:Name="ExportAllButton" Grid.Column="2" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Content="{l:T Export.All}"
                  Click="OnExportAllClick" IsEnabled="False" />
        </Grid>
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,12,16,12">

          <!-- Project -->
          <WrapPanel Margin="0,0,0,10">
            <WrapPanel.Styles>
              <Style Selector="Button">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </WrapPanel.Styles>
            <Button Content="{l:T Project.New}" Click="OnNewClick" ToolTip.Tip="{l:T Project.NewTip}" />
            <Button Content="{l:T Project.Open}" Click="OnOpenClick" ToolTip.Tip="{l:T Project.OpenTip}" />
            <Button Content="{l:T Project.Save}" Click="OnSaveClick" ToolTip.Tip="{l:T Project.SaveTip}" />
            <Button Content="{l:T Project.SaveAs}" Click="OnSaveAsClick" ToolTip.Tip="{l:T Project.SaveAsTip}" />
          </WrapPanel>

          <!-- Images -->
          <TextBlock Text="{l:T Images.Header}" FontWeight="SemiBold" FontSize="16" />
          <Grid ColumnDefinitions="*,6,Auto" Margin="0,6,0,4">
            <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{l:T Images.Add}" Click="OnAddImagesClick" />
            <Button x:Name="RemoveButton" Grid.Column="2" Content="{l:T Images.Remove}" Click="OnRemoveClick" IsEnabled="False" />
          </Grid>
          <ListBox x:Name="ImageList" Height="170" SelectionChanged="OnImageSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Source="{Binding Thumbnail}" Width="48" Height="48" Stretch="Uniform" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                    <TextBlock Text="{Binding SizeText}" Classes="hint" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="hint" Margin="0,4,0,0"
                     Text="{l:T Images.Tip}" />

          <!-- Image settings -->
          <Expander Header="{l:T ImageSettings.Header}" IsExpanded="True">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton x:Name="PositiveRadio" c:Help.Topic="Positive" Content="{l:T ImageSettings.Positive}" GroupName="polarity" IsChecked="True"
                             IsCheckedChanged="OnSettingChanged" />
                <RadioButton x:Name="NegativeRadio" c:Help.Topic="Negative" Content="{l:T ImageSettings.Negative}" GroupName="polarity"
                             IsCheckedChanged="OnSettingChanged" />
              </StackPanel>
              <CheckBox x:Name="MirrorCheck" c:Help.Topic="Mirror" Content="{l:T ImageSettings.Mirror}" IsCheckedChanged="OnSettingChanged" />
              <CheckBox x:Name="FlipCheck" c:Help.Topic="Flip" Content="{l:T ImageSettings.Flip}" IsCheckedChanged="OnSettingChanged" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Classes="label" Grid.Row="0" Text="{l:T ImageSettings.RepeatX}" c:Help.Topic="RepeatX" />
                <NumericUpDown x:Name="RepeatXBox" c:Help.Topic="RepeatX" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="20"
                               Increment="1" Value="1" FormatString="0" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="1" Text="{l:T ImageSettings.RepeatY}" c:Help.Topic="RepeatY" />
                <NumericUpDown x:Name="RepeatYBox" c:Help.Topic="RepeatY" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20"
                               Increment="1" Value="1" FormatString="0" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="2" Text="{l:T ImageSettings.Gamma}" c:Help.Topic="Gamma" />
                <NumericUpDown x:Name="GammaBox" c:Help.Topic="Gamma" Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="5"
                               Increment="0.1" Value="1" FormatString="0.0" ValueChanged="OnSettingChanged" />
              </Grid>
              <Button x:Name="RotateButton" c:Help.Topic="Rotate" Content="{l:T ImageSettings.Rotate}" Click="OnRotateClick" IsEnabled="False" />
            </StackPanel>
          </Expander>

          <!-- Model settings -->
          <Expander Header="{l:T Model.Header}" IsExpanded="True">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Classes="label" Grid.Row="0" Text="{l:T Model.Shape}" c:Help.Topic="Shape" />
                <ComboBox x:Name="ShapeCombo" VerticalAlignment="Center" c:Help.Topic="Shape" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                          SelectedIndex="0" SelectionChanged="OnShapeChanged" Margin="0,2">
                  <ComboBoxItem Content="{l:T Shape.Flat}" />
                  <ComboBoxItem Content="{l:T Shape.OuterCurve}" />
                  <ComboBoxItem Content="{l:T Shape.InnerCurve}" />
                  <ComboBoxItem Content="{l:T Shape.Cylinder}" />
                  <ComboBoxItem Content="{l:T Shape.Heart}" />
                  <ComboBoxItem Content="{l:T Shape.Dome}" />
                </ComboBox>
                <TextBlock Classes="label" Grid.Row="1" Text="{l:T Model.MaxSize}" c:Help.Topic="MaxSize" />
                <NumericUpDown x:Name="SizeBox" c:Help.Topic="MaxSize" Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="1000"
                               Increment="5" Value="100" FormatString="0.#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="2" Text="{l:T Model.Thickness}" c:Help.Topic="Thickness" />
                <NumericUpDown x:Name="ThicknessBox" c:Help.Topic="Thickness" Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="50"
                               Increment="0.1" Value="3" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="3" Text="{l:T Model.MinThickness}" c:Help.Topic="MinThickness" />
                <NumericUpDown x:Name="MinThicknessBox" c:Help.Topic="MinThickness" Grid.Row="3" Grid.Column="1" Minimum="0.1" Maximum="50"
                               Increment="0.1" Value="0.8" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="4" Text="{l:T Model.Border}" c:Help.Topic="Border" />
                <NumericUpDown x:Name="BorderBox" c:Help.Topic="Border" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100"
                               Increment="0.5" Value="3" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="5" Text="{l:T Model.Resolution}" c:Help.Topic="Resolution" />
                <NumericUpDown x:Name="ResolutionBox" c:Help.Topic="Resolution" Grid.Row="5" Grid.Column="1" Minimum="0.5" Maximum="20"
                               Increment="0.5" Value="5" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <TextBlock x:Name="CurveLabel" Classes="label" Grid.Row="6" Text="{l:T Model.CurveAngle}" c:Help.Topic="CurveAngle" />
                <NumericUpDown x:Name="CurveBox" c:Help.Topic="CurveAngle" Grid.Row="6" Grid.Column="1" Minimum="10" Maximum="350"
                               Increment="10" Value="120" FormatString="0" ValueChanged="OnSettingChanged" />
                <TextBlock x:Name="StandDepthLabel" Classes="label" Grid.Row="7" Text="{l:T Model.StandDepth}" c:Help.Topic="StandDepth" />
                <NumericUpDown x:Name="StandDepthBox" c:Help.Topic="StandDepth" Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="200"
                               Increment="1" Value="0" FormatString="0.#" ValueChanged="OnSettingChanged" />
                <TextBlock x:Name="StandHeightLabel" Classes="label" Grid.Row="8" Text="{l:T Model.StandHeight}" c:Help.Topic="StandHeight" />
                <NumericUpDown x:Name="StandHeightBox" c:Help.Topic="StandHeight" Grid.Row="8" Grid.Column="1" Minimum="0.5" Maximum="100"
                               Increment="0.5" Value="3" FormatString="0.0#" ValueChanged="OnSettingChanged" />
              </Grid>
              <TextBlock Classes="hint"
                         Text="{l:T Model.Hint}" />
            </StackPanel>
          </Expander>


          <!-- Light support -->
          <Expander Header="{l:T Light.Header}" IsExpanded="True">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Classes="label" Grid.Row="0" Text="{l:T Light.Source}" c:Help.Topic="LightSource" />
                <ComboBox x:Name="LightCombo" VerticalAlignment="Center" c:Help.Topic="LightSource" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                          SelectedIndex="0" SelectionChanged="OnLightChanged" Margin="0,2">
                  <ComboBoxItem Content="{l:T LightType.None}" />
                  <ComboBoxItem Content="{l:T LightType.LedStrip}" />
                  <ComboBoxItem Content="{l:T LightType.Lamp}" />
                </ComboBox>
                <TextBlock Classes="label" Grid.Row="1" Text="{l:T Light.SupportHeight}" c:Help.Topic="SupportHeight" />
                <NumericUpDown x:Name="SupportHeightBox" c:Help.Topic="SupportHeight" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="100"
                               Increment="1" Value="20" FormatString="0.#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="2" Text="{l:T Light.SlotDepth}" c:Help.Topic="SlotDepth" />
                <NumericUpDown x:Name="SlotDepthBox" c:Help.Topic="SlotDepth" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="30"
                               Increment="0.5" Value="4" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="3" Text="{l:T Light.SlotClearance}" c:Help.Topic="SlotClearance" />
                <NumericUpDown x:Name="ClearanceBox" c:Help.Topic="SlotClearance" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2"
                               Increment="0.05" Value="0.3" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="4" Text="{l:T Light.SupportWall}" c:Help.Topic="SupportWall" />
                <NumericUpDown x:Name="SupportWallBox" c:Help.Topic="SupportWall" Grid.Row="4" Grid.Column="1" Minimum="0.8" Maximum="10"
                               Increment="0.2" Value="2" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <TextBlock x:Name="MinDepthLabel" Classes="label" Grid.Row="5" Text="{l:T Light.MinDepth}" c:Help.Topic="SupportMinDepth" />
                <NumericUpDown x:Name="MinDepthBox" c:Help.Topic="SupportMinDepth" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="200"
                               Increment="1" Value="30" FormatString="0.#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="6" Text="{l:T Light.Cable}" c:Help.Topic="CableDiameter" />
                <NumericUpDown x:Name="CableBox" c:Help.Topic="CableDiameter" Grid.Row="6" Grid.Column="1" Minimum="2" Maximum="20"
                               Increment="0.5" Value="6" FormatString="0.0#" ValueChanged="OnSettingChanged" />
              </Grid>

              <Grid x:Name="LedPanel" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <TextBlock x:Name="LedWidthLabel" Classes="label" Grid.Row="0" Text="{l:T Light.LedWidth}" c:Help.Topic="LedChannelWidth" />
                <NumericUpDown x:Name="LedWidthBox" c:Help.Topic="LedChannelWidth" Grid.Row="0" Grid.Column="1" Minimum="3" Maximum="60"
                               Increment="1" Value="12" FormatString="0.#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="1" Text="{l:T Light.LedDepth}" c:Help.Topic="LedChannelDepth" />
                <NumericUpDown x:Name="LedDepthBox" c:Help.Topic="LedChannelDepth" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="80"
                               Increment="0.5" Value="6" FormatString="0.0#" ValueChanged="OnSettingChanged" />
              </Grid>

              <Grid x:Name="LampPanel" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Classes="label" Grid.Row="0" Text="{l:T Light.LampType}" c:Help.Topic="LampPreset" />
                <ComboBox x:Name="LampPresetCombo" VerticalAlignment="Center" c:Help.Topic="LampPreset" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                          SelectedIndex="0" SelectionChanged="OnLampPresetChanged" Margin="0,2">
                  <ComboBoxItem Content="{l:T LampPreset.TeaLight}" />
                  <ComboBoxItem Content="{l:T LampPreset.Puck}" />
                  <ComboBoxItem Content="{l:T LampPreset.E14}" />
                  <ComboBoxItem Content="{l:T LampPreset.E27}" />
                  <ComboBoxItem Content="{l:T LampPreset.M10}" />
                  <ComboBoxItem Content="{l:T Common.Custom}" />
                </ComboBox>
                <TextBlock Classes="label" Grid.Row="1" Text="{l:T Light.LampDiameter}" c:Help.Topic="LampDiameter" />
                <NumericUpDown x:Name="LampDiameterBox" c:Help.Topic="LampDiameter" Grid.Row="1" Grid.Column="1" Minimum="3" Maximum="200"
                               Increment="0.5" Value="40" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <TextBlock Classes="label" Grid.Row="2" Text="{l:T Light.LampDepth}" c:Help.Topic="LampDepth" />
                <NumericUpDown x:Name="LampDepthBox" c:Help.Topic="LampDepth" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="80"
                               Increment="0.5" Value="12" FormatString="0.0#" ValueChanged="OnSettingChanged" />
                <CheckBox x:Name="ThroughCheck" c:Help.Topic="LampThrough" Grid.Row="3" Grid.ColumnSpan="2"
                          IsCheckedChanged="OnSettingChanged">
                  <TextBlock Text="{l:T Light.Through}" TextWrapping="Wrap" />
                </CheckBox>
              </Grid>

              <CheckBox x:Name="ShowLightCheck" c:Help.Topic="ShowLight" IsChecked="True"
                        IsCheckedChanged="OnShowLightChanged">
                <TextBlock Text="{l:T Light.ShowLight}" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock x:Name="LightHint" Classes="hint"
                         Text="{l:T Light.Hint}" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#20808080" />

    <!-- Preview -->
    <DockPanel Grid.Column="2">
      <Border DockPanel.Dock="Top" Padding="10,6">
        <DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="12" DockPanel.Dock="Left">
            <ToggleSwitch x:Name="BacklitSwitch" c:Help.Topic="Backlit" OnContent="{l:T Preview.Backlit}" OffContent="{l:T Preview.Backlit}"
                          IsCheckedChanged="OnBacklitChanged" />
            <Button Content="{l:T Preview.ResetView}" Click="OnResetViewClick" />
          </StackPanel>
          <ComboBox x:Name="LanguageCombo" DockPanel.Dock="Right" MinWidth="120" Margin="12,0,0,0" VerticalAlignment="Center"
                    SelectionChanged="OnLanguageSelected" ToolTip.Tip="{l:T Language.Tip}" />
          <TextBlock x:Name="StatusText" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{l:T Preview.Hint}" />
        </DockPanel>
      </Border>
      <Border x:Name="SimPanel" DockPanel.Dock="Top" Padding="10,0,10,6" IsVisible="False">
        <WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
            <TextBlock Classes="label" Text="{l:T Preview.Light}" c:Help.Topic="LightColor" />
            <ComboBox x:Name="LightPresetCombo" c:Help.Topic="LightColor" MinWidth="190" SelectedIndex="0" SelectionChanged="OnLightPresetChanged">
              <ComboBoxItem Content="{l:T LightPreset.Warm}" />
              <ComboBoxItem Content="{l:T LightPreset.Soft}" />
              <ComboBoxItem Content="{l:T LightPreset.Neutral}" />
              <ComboBoxItem Content="{l:T LightPreset.Cool}" />
              <ComboBoxItem Content="{l:T Color.Red}" />
              <ComboBoxItem Content="{l:T Color.Orange}" />
              <ComboBoxItem Content="{l:T Color.Yellow}" />
              <ComboBoxItem Content="{l:T Color.Green}" />
              <ComboBoxItem Content="{l:T Color.Blue}" />
              <ComboBoxItem Content="{l:T Color.Purple}" />
              <ComboBoxItem Content="{l:T Common.Custom}" />
            </ComboBox>
            <ColorPicker x:Name="LightColorPicker" c:Help.Topic="LightColor" Color="#FFA957" Width="44" Height="30"
                         IsAlphaEnabled="False" IsAlphaVisible="False" ColorChanged="OnLightColorPicked" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
            <TextBlock Classes="label" Text="{l:T Preview.Power}" c:Help.Topic="LightPower" />
            <Slider x:Name="PowerSlider" c:Help.Topic="LightPower" Width="120" Minimum="0.1" Maximum="4" Value="1" VerticalAlignment="Center"
                    ValueChanged="OnPowerChanged" />
            <TextBlock x:Name="PowerText" Classes="label" Text="" MinWidth="42" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
            <TextBlock Classes="label" Text="{l:T Preview.Filament}" c:Help.Topic="Filament" />
            <ComboBox x:Name="FilamentPresetCombo" c:Help.Topic="Filament" MinWidth="120" SelectedIndex="0" SelectionChanged="OnFilamentPresetChanged">
              <ComboBoxItem Content="{l:T Filament.White}" />
              <ComboBoxItem Content="{l:T Filament.Ivory}" />
              <ComboBoxItem Content="{l:T Filament.LightGrey}" />
              <ComboBoxItem Content="{l:T Color.Yellow}" />
              <ComboBoxItem Content="{l:T Color.Orange}" />
              <ComboBoxItem Content="{l:T Color.Red}" />
              <ComboBoxItem Content="{l:T Color.Pink}" />
              <ComboBoxItem Content="{l:T Color.Green}" />
              <ComboBoxItem Content="{l:T Color.Blue}" />
              <ComboBoxItem Content="{l:T Color.Purple}" />
              <ComboBoxItem Content="{l:T Common.Custom}" />
            </ComboBox>
            <ColorPicker x:Name="FilamentColorPicker" c:Help.Topic="Filament" Color="#FFFFFF" Width="44" Height="30"
                         IsAlphaEnabled="False" IsAlphaVisible="False" ColorChanged="OnFilamentColorPicked" />
          </StackPanel>
        </WrapPanel>
      </Border>
      <Panel>
        <c:PreviewControl x:Name="Preview" />
        <TextBlock x:Name="EmptyHint" Text="{l:T Preview.Empty}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B0FFFFFF"
                   FontSize="18" IsHitTestVisible="False" />
      </Panel>
    </DockPanel>
  </Grid>
</Window>
